[
  {
    "id": "cata-v1",
    "key": "cata",
    "name": "CATA \u2014 Check all that apply",
    "schema_version": 1,
    "configuration_schema": {
      "$defs": {
        "Question": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Id",
              "type": "string"
            },
            "prompt": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Prompt",
              "type": "string"
            },
            "required": {
              "default": true,
              "title": "Required",
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "prompt"
          ],
          "title": "Question",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "sample_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Sample Ids",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "allow_skips": {
          "default": false,
          "title": "Allow Skips",
          "type": "boolean"
        },
        "kind": {
          "const": "cata",
          "default": "cata",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "instructions",
        "questions"
      ],
      "title": "CATAConfiguration",
      "type": "object"
    },
    "method_metadata": {
      "source_url": "https://doi.org/10.1016/j.foodqual.2019.103794",
      "description": "Select applicable attributes; unselected is explicit.",
      "renderer_status": "implemented",
      "response_validator_status": "implemented",
      "implementation_scope": "collection and researcher rehearsal; statistical analysis not implemented"
    }
  },
  {
    "id": "rata-v1",
