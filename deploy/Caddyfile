{
    admin off
    auto_https disable_certs
}

{$LAB_HOSTNAME} {
    tls /run/secrets/tls_certificate /run/secrets/tls_key
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy app:8000 {
        # Stream future operational SSE without response buffering.
        flush_interval -1
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}
