# Copy to deploy/private/lab.env. Never put a real lab configuration in Git.
# IT supplies actual tested release/registry digests, not mutable tags.
APP_IMAGE=registry.example.edu/sensibilia@sha256:REPLACE_WITH_RELEASE_DIGEST
TLS_IMAGE=caddy@sha256:REPLACE_WITH_REVIEWED_DIGEST
LAB_INTERFACE=192.168.50.10
LAB_HOSTNAME=sensory.example.edu
BACKUP_DIRECTORY=/srv/sensibilia-backups
RESEARCHER_TOKEN_FILE=/srv/sensibilia-secrets/researcher-token
# Separate serving-staff key; must differ from the researcher key.
OPERATOR_TOKEN_FILE=/srv/sensibilia-secrets/operator-token
TLS_CERTIFICATE_FILE=/srv/sensibilia-secrets/fullchain.pem
TLS_KEY_FILE=/srv/sensibilia-secrets/key.pem
DATA_VOLUME=sensibilia_laboratory_data

# Dedicated container network: IT checks for overlap with LAN/VPN/Docker routes.
PROXY_SUBNET=172.28.99.0/29
TLS_PROXY_IP=172.28.99.2

# Immutable stimulus files; preserve this volume with DATA_VOLUME.
ASSETS_VOLUME=sensibilia_laboratory_assets
